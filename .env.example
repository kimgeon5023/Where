# Managed PostgreSQL connection string (Neon, Supabase, Render, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Keep true for Render and other managed cloud databases. Set false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true

# Use a different value for each site deployment while sharing DATABASE_URL.
SITE_ID=where-main

# Optional PostgreSQL connection pool size.
DATABASE_POOL_SIZE=10

# Cloud hosts normally inject PORT automatically. This is the local default.
PORT=3001
# Set only for local API development when a browser calls the API directly.
NODE_ENV=development

# OAuth backend URLs. Set these on the Render API service.
FRONTEND_URL=https://where-silk.vercel.app
# Comma-separated list is allowed when serving multiple production frontend domains.
# Local Vite origins are allowed only when NODE_ENV is not production.
API_BASE_URL=https://where-api-kimgeon5023.onrender.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Use a long, random value in production so login tokens remain valid across API restarts.
AUTH_TOKEN_SECRET=your_long_random_auth_token_secret

# Initial administrator. These values are used only to create the account and
# ensure it retains the admin role; never commit the real password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_admin_password

VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key

# Production frontend only: public URL of the Render API service, without a trailing slash.
VITE_API_BASE_URL=https://where-api-kimgeon5023.onrender.com

# Kakao Maps JavaScript key (register Vercel domain in Kakao Developers first).
VITE_KAKAO_MAP_JS_KEY=your_kakao_javascript_key

# Kakao REST key (Render only; never expose this in VITE_* variables).
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Kakao Mobility directions REST key (Render only). Enable the Directions API for this key.
KAKAO_MOBILITY_REST_API_KEY=your_kakao_mobility_rest_api_key

# ODsay public-transit API key (Render only). Without it, public routes use a
# haversine-based time/fare estimate.
ODSAY_API_KEY=your_odsay_api_key

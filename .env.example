# Managed PostgreSQL connection string (Neon, Supabase, Render, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Keep true for Render and other managed cloud databases. Set false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true

# Use a different value for each site deployment while sharing DATABASE_URL.
SITE_ID=where-main

# Optional PostgreSQL connection pool size.
DATABASE_POOL_SIZE=10

# Cloud hosts normally inject PORT automatically. This is the local default.
PORT=3001

VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key

# Production frontend only: public URL of the Render API service, without a trailing slash.
VITE_API_BASE_URL=https://where-api.onrender.com
